# =============================================================================
# VitsZee Frontend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values for your environment.
# NEVER commit .env with real secrets to version control.
# All variables must be prefixed with VITE_ to be accessible in the browser.
# =============================================================================


# --- Backend API URL ---
# Required: Point to your deployed backend server.
# Example: https://vitzee-backend.onrender.com
VITE_API_URL=https://your-backend-url.com


# --- Google Maps ---
# Required for map features (customer address, delivery tracking, seller locations).
# Enable: Maps JavaScript API + Geocoding API + Places API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here


# --- Firebase (Optional) ---
# Required only if push notifications / real-time features are enabled.
# Leave blank to disable Firebase (the app gracefully skips Firebase init).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase Cloud Messaging VAPID key (for web push notifications)
VITE_FIREBASE_VAPID_KEY=


# --- Feature Flags ---
# Return window in minutes (how long customers can return an order)
VITE_RETURN_WINDOW_MINUTES=15
