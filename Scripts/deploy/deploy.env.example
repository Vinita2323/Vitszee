# Copy to /etc/vitszee/deploy.env on the server (or APP_DIR/.deploy.env)
# chmod 600 that file — never commit real secrets.

# Absolute path to the git clone on the server
APP_DIR=/var/www/vitszee

# Git branch to deploy
DEPLOY_BRANCH=main

# Frontend build output sync target (nginx / apache web root). Leave empty to skip copy.
# Example: /var/www/html   or   /var/www/vitszee/frontend/dist is already served
WEB_ROOT=

# Backend health URL (local)
HEALTH_URL=http://127.0.0.1:7000/health
READY_URL=http://127.0.0.1:7000/health/ready

# Public hostname check (optional). Leave empty to skip.
PUBLIC_HEALTH_URL=https://vitszee.com/health

# PM2 process names to restart (space-separated). Use "all" to restart everything.
PM2_APP_NAMES=all

# Node / npm
NODE_ENV=production
NPM_INSTALL_FLAGS=--omit=dev

# Set to 1 to skip frontend build (API-only deploys)
SKIP_FRONTEND=0

# Set to 1 to skip backend npm install
SKIP_BACKEND_INSTALL=0
